MR_ENSEIGNE=
MR_CLE_PRIVEE=
MR_MODE_COL=CCC
# A4, A5 ou 10x15 selon l'imprimante
MR_FORMAT=A4
MR_EXPE_NOM=
MR_EXPE_TEL=
