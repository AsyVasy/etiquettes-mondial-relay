# Connexion Odoo. Rempli par la fenêtre Réglages. Ne jamais envoyer ce fichier rempli.
# Adresse du site Odoo, ex. https://www.exemple.fr
ODOO_URL=
# Nom de la base Odoo
ODOO_DB=
# Nom exact de la base de production : vraies étiquettes payées. Vide ou différent = simulation.
ODOO_BASE_PROD=
# Identifiant de connexion Odoo (e-mail)
ODOO_USER=
# Clé API : Odoo > nom en haut à droite > Mon profil > Sécurité du compte > Nouvelle clé API
ODOO_API_KEY=
